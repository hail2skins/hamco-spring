# HAMCO Spring local development template. Copy to .env only if needed.
# Spring Boot does NOT auto-load this file; export variables in your shell.
# Never commit .env or copy the ASP.NET example's password-shaped values.

# This is a NEW Spring-owned database; never point at hamco_dev or the
# existing ASP.NET/Railway schemas until a separate migration is approved.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hamco_spring_dev
SPRING_DATASOURCE_USERNAME=art
SPRING_DATASOURCE_PASSWORD=

# Registration is deliberately off unless explicitly enabled for local tests.
ALLOW_REGISTRATION=false
APP_BASE_URL=http://localhost:8080

# Locally a blank JWT_KEY uses a random, ephemeral signing key each startup.
# In production provide a strong, environment-specific secret (>= 32 bytes).
JWT_KEY=
JWT_ISSUER=hamco-api
JWT_AUDIENCE=hamco-client

# Local mode captures verification/reset links in memory for integration tests.
# Mailjet mode requires the real Mailjet fields below and should be configured
# only in the appropriate environment's secret manager, not in this file.
HAMCO_MAIL_MODE=local
MAILJET_API_KEY=
MAILJET_API_SECRET=
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=HAMCO
